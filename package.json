{
  "name": "playwright-cucumber",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cucumberWithOutTs": "cucumber-js src/features/*.feature --require-module ts-node/register --require src/step-definitions/**/**/*.ts --require src/utils/cucumber-timeout.ts",
    "precucumber": "rimraf reports && mkdir reports",
    "cucumber": "npx cucumber-js src/features",
    "cucumber:smoke": "npx cucumber-js src/features --tags @smoke",
    "cucumber:amazon": "npx cucumber-js src/features --tags @amazon",
    "cucumber:amazon:fresh": "npx cucumber-js src/features/amazon-fresh.feature",
    "cucumber:amazon:prime": "npx cucumber-js src/features/amazon-prime.feature",
    "cucumber:amazon:sell": "npx cucumber-js src/features/amazon-sell.feature"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@colors/colors": "^1.6.1",
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "rimarf": "^0.0.1-security",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  }
}
